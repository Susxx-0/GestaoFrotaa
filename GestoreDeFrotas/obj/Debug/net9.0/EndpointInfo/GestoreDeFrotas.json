{
  "openapi": "3.0.1",
  "info": {
    "title": "GestoreDeFrotas",
    "version": "1.0"
  },
  "paths": {
    "/api/Dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/teste-token": {
      "post": {
        "tags": [
          "GestoreDeFrotas"
        ],
        "parameters": [
          {
            "name": "cargo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/logs/teste": {
      "get": {
        "tags": [
          "Logging"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/maintenance": {
      "get": {
        "tags": [
          "Manutencao"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Manutencao"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistoManutencao"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistoManutencao"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegistoManutencao"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/vehicles": {
      "get": {
        "tags": [
          "Veiculos"
        ],
        "parameters": [
          {
            "name": "marca",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "modelo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "matricula",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "anoMin",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "anoMax",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Veiculos"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Veiculo"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Veiculo"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Veiculo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/vehicles/{id}": {
      "delete": {
        "tags": [
          "Veiculos"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegistoManutencao": {
        "required": [
          "data",
          "descricao",
          "veiculoId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "veiculoId": {
            "type": "integer",
            "format": "int32"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "descricao": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string"
          },
          "custo": {
            "maximum": 100000,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "realizadoPor": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Veiculo": {
        "required": [
          "estado",
          "marca",
          "matricula",
          "modelo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "marca": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "modelo": {
            "minLength": 1,
            "type": "string"
          },
          "matricula": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}$",
            "type": "string"
          },
          "cor": {
            "type": "string",
            "nullable": true
          },
          "ano": {
            "maximum": 2027,
            "minimum": 1970,
            "type": "integer",
            "format": "int32"
          },
          "estado": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Insira o token JWT desta forma: Bearer SEU_TOKEN_AQUI",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}
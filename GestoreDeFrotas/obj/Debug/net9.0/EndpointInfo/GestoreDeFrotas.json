  "components": {
    "schemas": {
      "Abastecimento": {
        "required": [
          "combustivel",
          "kmAtual",
          "litros",
          "precoPorLitro",
          "veiculoId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "veiculoId": {
            "type": "integer",
            "format": "int32"
          },
          "veiculo": {
            "$ref": "#/components/schemas/Veiculo"
          },
          "litros": {
            "maximum": 200,
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "precoPorLitro": {
            "maximum": 10,
            "minimum": 0,1,
            "type": "number",
            "format": "double"
          },
          "custoTotal": {
            "type": "number",
            "format": "double"
          },
          "kmAtual": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "consumoMedio": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "kmPorLitro": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "combustivel": {
            "minLength": 1,
            "type": "string"
          },
          "posto": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "faturaPath": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegistoManutencao": {
        "required": [
          "data",
          "descricao",
          "km",
          "veiculoId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "veiculoId": {
            "type": "integer",
            "format": "int32"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "descricao": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string"
          },
          "custo": {
            "maximum": 100000,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "realizadoPor": {
            "type": "string",
            "nullable": true
          },
          "km": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Veiculo": {
        "required": [
          "estado",
          "marca",
          "matricula",
          "modelo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "marca": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "modelo": {
            "minLength": 1,
            "type": "string"
          },
          "matricula": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{2}-[A-Z0-9]{2}-[A-Z0-9]{2}$",
            "type": "string"
          },
          "cor": {
            "type": "string",
            "nullable": true
          },
          "ano": {
            "maximum": 2027,
            "minimum": 1970,
            "type": "integer",
            "format": "int32"
          },
          "estado": {
            "minLength": 1,
            "type": "string"
          },
          "kmAtual": {
            "type": "integer",
            "format": "int32"
          },
          "intervaloManutencaoKm": {
            "type": "integer",
            "format": "int32"
          },
          "ultimaManutencaoData": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ultimaManutencaoKm": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Insira o token JWT desta forma: Bearer SEU_TOKEN_AQUI",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
